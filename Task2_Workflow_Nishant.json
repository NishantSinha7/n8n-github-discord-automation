    {
      "parameters": {
        "jsCode": "const lines = $input.all().map(i => {\n  const r = i.json;\n\n  return `[${r.tag}] ${r.name} - ${r.stars} stars - last commit ${r.lastCommit}\n${r.url}`;\n});\n\nreturn [\n  {\n    json: {\n      message:\n        'Morning Brief: top GitHub automation repos\\n\\n' +\n        lines.join('\\n\\n')\n    }\n  }\n];"
      },
