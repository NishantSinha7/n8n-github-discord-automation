    {
      "parameters": {
        "jsCode": "   const repos = ($input.first().json.items || [])\n     .sort((a, b) => b.stargazers_count - a.stargazers_count)\n     .slice(0, 5);\n   return repos.map(r => ({ json: {\n     name: r.full_name, stars: r.stargazers_count,\n     url: r.html_url, description: r.description || 'No description'\n   }}));"
      },
